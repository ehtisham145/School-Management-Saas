SECRET_KEY='change-me'
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME

# REDIS_URL=redis://localhost:6379/0
# LEADS_EMAIL=info@lessonlab.me

# Branded emails. A blank value hides that part of the footer.
# COMPANY_WEBSITE=https://app.example.com
# COMPANY_ADDRESS=
# SUPPORT_EMAIL=support@lessonlab.me
# BRAND_HEADER_LABEL=School Management
# By default the logo is attached to each email. To link to it instead, use a public URL.
# BRAND_LOGO_URL=https://app.example.com/brand/logo-on-dark.png

# Quotations. The VAT number shows on the PDF; blank hides it.
# COMPANY_VAT_NUMBER=
# QUOTATION_VAT_RATE=15.00
# QUOTATION_VALID_DAYS=30

# Email. Leave EMAIL_HOST out to print emails in the terminal during development.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=info@lessonlab.me
# EMAIL_HOST_PASSWORD='your-password'
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=Lesson Lab <your domain>

# AI. Lesson plans, tests and the browser agent use this key.
# OPENAI_API_KEY=

# Browser agent (docs/browser-agent.md §12). Off by default. In production, turning it on
# needs OPENAI_API_KEY and Redis, and the model must be in BROWSER_AGENT_PRICES.
# BROWSER_AGENT_ENABLED=False
# BROWSER_AGENT_MODEL=gpt-4o-mini
# BROWSER_AGENT_MAX_STEPS=30
# BROWSER_AGENT_MAX_SECONDS=600
# BROWSER_AGENT_MAX_INPUT_TOKENS=120000
# BROWSER_AGENT_MAX_PAGES=5
# BROWSER_AGENT_MAX_STRIKES=3
# BROWSER_AGENT_MAX_PAGE_CHARS=12000
# BROWSER_AGENT_MAX_OUTPUT_TOKENS=800
# BROWSER_AGENT_MAX_COST_USD_PER_TASK=0.20
# BROWSER_AGENT_MONTHLY_BUDGET_USD=100
# BROWSER_AGENT_MAX_RUNNING_PER_USER=1
# BROWSER_AGENT_MAX_RUNNING_TOTAL=10
# BROWSER_AGENT_THROTTLE_RATE=10/hour
# BROWSER_AGENT_WS_IDLE_SECONDS=300
# Comma-separated. Setting BLOCKED replaces the whole default list (see settings/base.py).
# BROWSER_AGENT_BLOCKED_DOMAINS=paypal.com,stripe.com,absher.sa
# Empty = every public domain except the blocked ones.
# BROWSER_AGENT_ALLOWED_DOMAINS=
# Ports the agent may open (a URL without a port uses 80/443). Comma-separated.
# BROWSER_AGENT_ALLOWED_PORTS=80,443
# A slower DNS lookup refuses the URL.
# BROWSER_AGENT_DNS_TIMEOUT_SECONDS=3

# Login lockout (django-axes): failed attempts per username + IP before a 1-hour lock.
# AXES_FAILURE_LIMIT=15

# Production only:
# FRONTEND_URL=https://app.example.com

# ALLOWED_HOSTS=app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# HSTS: start low, raise to 31536000 once HTTPS works everywhere. Caddy reads it too.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Proxies in front of Django. 1 = Caddy only; valid only if the app port is not public.
# NUM_PROXIES=1
