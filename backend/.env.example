SECRET_KEY='change-me'
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME

# REDIS_URL=redis://localhost:6379/0
# LEADS_EMAIL=info@lessonlab.me

# Branded emails. A blank value hides that part of the footer.
# COMPANY_WEBSITE=https://app.example.com
# COMPANY_ADDRESS=
# SUPPORT_EMAIL=support@lessonlab.me
# BRAND_HEADER_LABEL=School Management
# By default the logo is attached to each email. To link to it instead, use a public URL.
# BRAND_LOGO_URL=https://app.example.com/brand/logo-on-dark.png

# Quotations. The VAT number shows on the PDF; blank hides it.
# COMPANY_VAT_NUMBER=
# QUOTATION_VAT_RATE=15.00
# QUOTATION_VALID_DAYS=30

# Email. Leave EMAIL_HOST out to print emails in the terminal during development.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=info@lessonlab.me
# EMAIL_HOST_PASSWORD='your-password'
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=Lesson Lab <your domain>

# Production only:
# FRONTEND_URL=https://app.example.com

# ALLOWED_HOSTS=app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
