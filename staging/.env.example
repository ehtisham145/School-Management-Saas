# Copy to .env on the server and run: chmod 600 .env
# Generate each secret with: openssl rand -hex 32
# Hex values only: these passwords go inside connection URLs.

BACKEND_IMAGE=
FRONTEND_IMAGE=

SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# The first host is also used by the container health check.
ALLOWED_HOSTS=staging.lessonlab.me
CSRF_TRUSTED_ORIGINS=https://staging.lessonlab.me
FRONTEND_URL=https://staging.lessonlab.me
COMPANY_WEBSITE=https://staging.lessonlab.me

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Lesson Lab <info@lessonlab.me>
LEADS_EMAIL=info@lessonlab.me
SUPPORT_EMAIL=support@lessonlab.me
